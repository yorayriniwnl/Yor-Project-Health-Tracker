generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  GOVERNMENT_ADMIN
  PROJECT_MANAGER
  AUDITOR
  CONTRACTOR
  PUBLIC_VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  DELAYED
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum HealthStatus {
  HEALTHY
  WATCHLIST
  CRITICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceStatus {
  PENDING
  VERIFIED
  NON_COMPLIANT
  UNDER_REVIEW
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  WARRANTY
}

enum DocumentType {
  DPR
  CONTRACT
  INVOICE
  PHOTO_COMPLETION
  AUDIT_REPORT
  COMPLETION_REPORT
  OTHER
}

model User {
  id           String       @id @default(cuid())
  fullName     String       @map("full_name")
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         Role         @default(PUBLIC_VIEWER)
  departmentId String?      @map("department_id")
  department   Department?  @relation(fields: [departmentId], references: [id])
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  createdProjects Project[]         @relation("ProjectCreator")
  documents       ProjectDocument[]
  auditLogs       AuditLog[]
  reportedRisks   ProjectRisk[]

  @@map("users")
}

model Department {
  id           String    @id @default(cuid())
  name         String
  ministryName String    @map("ministry_name")
  region       String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  users    User[]
  projects Project[]

  @@map("departments")
}

model Contractor {
  id                    String   @id @default(cuid())
  contractorName        String   @map("contractor_name")
  companyName           String   @map("company_name")
  registrationNumber    String   @unique @map("registration_number")
  yearsExperience       Int      @default(0) @map("years_experience")
  pastProjectsHandled   Int      @default(0) @map("past_projects_handled")
  totalProjectsDelivered Int     @default(0) @map("total_projects_delivered")
  completedOnTime       Int      @default(0) @map("completed_on_time")
  completedWithinBudget Int      @default(0) @map("completed_within_budget")
  successRate           Float    @default(0) @map("success_rate")
  qualityRating         Float    @default(0) @map("quality_rating")
  blacklisted           Boolean  @default(false)
  disputeHistory        String?  @map("dispute_history")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("contractors")
}

model Broker {
  id                    String           @id @default(cuid())
  brokerName            String           @map("broker_name")
  organization          String?
  role                  String?
  feeAmount             Decimal          @default(0) @map("fee_amount") @db.Decimal(18, 2)
  commissionPercentage  Float            @default(0) @map("commission_percentage")
  complianceStatus      ComplianceStatus @default(PENDING) @map("compliance_status")
  conflictOfInterest    Boolean          @default(false) @map("conflict_of_interest")
  riskLevel             RiskLevel        @default(LOW) @map("risk_level")
  remarks               String?
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  projects Project[]

  @@map("brokers")
}

model Project {
  id                      String        @id @default(cuid())
  projectCode             String        @unique @map("project_code")
  projectName             String        @map("project_name")
  description             String?
  departmentId            String        @map("department_id")
  department              Department    @relation(fields: [departmentId], references: [id])
  location                String
  projectType             String        @map("project_type")
  status                  ProjectStatus @default(PLANNED)
  budgetAllocated         Decimal       @map("budget_allocated") @db.Decimal(18, 2)
  budgetReleased          Decimal       @default(0) @map("budget_released") @db.Decimal(18, 2)
  budgetSpent             Decimal       @default(0) @map("budget_spent") @db.Decimal(18, 2)
  budgetRemaining         Decimal       @default(0) @map("budget_remaining") @db.Decimal(18, 2)
  startDate               DateTime      @map("start_date")
  expectedCompletionDate  DateTime      @map("expected_completion_date")
  actualCompletionDate    DateTime?     @map("actual_completion_date")
  expectedDurationDays    Int           @map("expected_duration_days")
  progressPercentage      Float         @default(0) @map("progress_percentage")
  contractorId            String?       @map("contractor_id")
  contractor              Contractor?   @relation(fields: [contractorId], references: [id])
  brokerId                String?       @map("broker_id")
  broker                  Broker?       @relation(fields: [brokerId], references: [id])
  expectedMaintenanceCost Decimal       @default(0) @map("expected_maintenance_cost") @db.Decimal(18, 2)
  actualMaintenanceCost   Decimal       @default(0) @map("actual_maintenance_cost") @db.Decimal(18, 2)
  annualMaintenanceCost   Decimal       @default(0) @map("annual_maintenance_cost") @db.Decimal(18, 2)
  healthScore             Float         @default(0) @map("health_score")
  healthStatus            HealthStatus  @default(WATCHLIST) @map("health_status")
  riskLevel               RiskLevel     @default(LOW) @map("risk_level")
  createdById             String        @map("created_by")
  createdBy               User          @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  milestones         Milestone[]
  maintenanceRecords MaintenanceRecord[]
  documents          ProjectDocument[]
  risks              ProjectRisk[]

  @@index([departmentId])
  @@index([contractorId])
  @@index([brokerId])
  @@index([status])
  @@index([healthStatus])
  @@index([location])
  @@map("projects")
}

model Milestone {
  id                 String          @id @default(cuid())
  projectId          String          @map("project_id")
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneName      String          @map("milestone_name")
  description        String?
  plannedStartDate   DateTime?       @map("planned_start_date")
  plannedEndDate     DateTime?       @map("planned_end_date")
  actualStartDate    DateTime?       @map("actual_start_date")
  actualEndDate      DateTime?       @map("actual_end_date")
  progressPercentage Float           @default(0) @map("progress_percentage")
  status             MilestoneStatus @default(NOT_STARTED)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("milestones")
}

model MaintenanceRecord {
  id              String          @id @default(cuid())
  projectId       String          @map("project_id")
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  maintenanceType MaintenanceType @default(PREVENTIVE) @map("maintenance_type")
  expectedCost    Decimal         @default(0) @map("expected_cost") @db.Decimal(18, 2)
  actualCost      Decimal         @default(0) @map("actual_cost") @db.Decimal(18, 2)
  vendorName      String?         @map("vendor_name")
  maintenanceDate DateTime?       @map("maintenance_date")
  nextDueDate     DateTime?       @map("next_due_date")
  riskLevel       RiskLevel       @default(LOW) @map("risk_level")
  remarks         String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("maintenance_records")
}

model ProjectDocument {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentName String       @map("document_name")
  documentType DocumentType @default(OTHER) @map("document_type")
  fileUrl      String       @map("file_url")
  uploadedById String       @map("uploaded_by")
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([projectId])
  @@map("project_documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProjectRisk {
  id              String    @id @default(cuid())
  projectId       String    @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  riskTitle       String    @map("risk_title")
  riskDescription String?   @map("risk_description")
  riskLevel       RiskLevel @default(MEDIUM) @map("risk_level")
  reportedById    String?   @map("reported_by")
  reportedBy      User?     @relation(fields: [reportedById], references: [id])
  status          String    @default("OPEN")
  resolutionNotes String?   @map("resolution_notes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("project_risks")
}
